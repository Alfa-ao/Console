<?xml version="1.0" encoding="utf-8"?>
<WidgetButton>
	<Name>Close</Name>
	<Priority>1</Priority>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<HighPos>9</HighPos>
			<Size>16</Size>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Pos>10</Pos>
			<Size>16</Size>
		</Y>
	</Placement>
	<IgnoreDblClick>true</IgnoreDblClick>
	<Variants>
		<Item>
			<LayerHighlight href="../Textures/Close/Highlight.(WidgetLayerSimpleTexture).xdb" />
			<StateNormal>
				<LayerMain href="../Textures/Close/Normal.(WidgetLayerSimpleTexture).xdb" />
			</StateNormal>
			<StatePushed>
				<LayerMain href="../Textures/Close/Pushed.(WidgetLayerSimpleTexture).xdb" />
			</StatePushed>
			<Reaction>close_click</Reaction>
			<ReactionOnUp>true</ReactionOnUp>
		</Item>
	</Variants>
</WidgetButton>